Y_data = Male_data_64(:,2); % Weight
Z_data= X_data.*Y_data; % Height^c*Weight
PP = polyfit(Z_data,Y_data,1); % linear fitting
Coefficient_a_Male_1_KNHANES_2001 = [Coefficient_a_Male_1_KNHANES_2001 PP(2)];
Coefficient_b_Male_1_KNHANES_2001 = [Coefficient_b_Male_1_KNHANES_2001 PP(1)];
