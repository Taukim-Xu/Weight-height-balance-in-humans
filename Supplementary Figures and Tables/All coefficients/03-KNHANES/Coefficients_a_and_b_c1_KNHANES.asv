% We calculate the coefficients of a and b in 1=a/Weight+b*Height for this
% dataset
Age_KNHANES_2014 = 1:80;
Coefficient_a_Female_1_KNHANES_2014 = [];
Coefficient_b_Female_1_KNHANES_2014 = [];
Coefficient_a_Male_1_KNHANES_2014 = [];
Coefficient_b_Male_1_KNHANES_2014 = [];

% For Female
% Age 1
X_data = (Female_data_1(:,1)/100).^c; % Height (m)
Y_data = Female_data_1(:,2); % Weight
Z_data= X_data.*Y_data; % Height^c*Weight
PP = polyfit(Z_data,Y_data,1); % linear fitting
Coefficient_a_Female_1_KNHANES_2014 = [Coefficient_a_Female_1_KNHANES_2014 PP(2)];
Coefficient_b_Female_1_KNHANES_2014 = [Coefficient_b_Female_1_KNHANES_2014 PP(1)];
