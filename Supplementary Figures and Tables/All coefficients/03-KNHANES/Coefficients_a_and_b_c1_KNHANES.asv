% For Female
[M N] = size(Female_data); % Height (cm); Weight (Kg)
for i=1:M
    if Female_data(i,1) == 1
        Female_data_1 = [Female_data_1;Female_data(i,2) Female_data(i,3)];
    end
    if Female_data(i,1) == 2
        Female_data_2 = [Female_data_2;Female_data(i,2) Female_data(i,3)];
