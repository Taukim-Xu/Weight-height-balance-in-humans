% We calculate the coefficients of a and b in 1=a/Weight+b*Height for this
% dataset
Age_KNHANES_2018 = 1:80;
Coefficient_a_Female_1_KNHANES_2018 = [];
Coefficient_b_Female_1_KNHANES_2018 = [];
Coefficient_a_Male_1_KNHANES_2018 = [];
Coefficient_b_Male_1_KNHANES_2018 = [];

% For Female
