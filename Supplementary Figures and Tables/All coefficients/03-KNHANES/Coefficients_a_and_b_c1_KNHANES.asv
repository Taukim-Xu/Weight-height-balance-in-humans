PP = polyfit(Z_data,Y_data,1); % linear fitting
Coefficient_a_Male_1_KNHANES_2013 = [Coefficient_a_Male_1_KNHANES_2013 PP(2)];
Coefficient_b_Male_1_KNHANES_2013 = [Coefficient_b_Male_1_KNHANES_2013 PP(1)];
% Age 77
X_data = (Male_data_77(:,1)/100).^c; % Height (m)
Y_data = Male_data_77(:,2); % Weight
Z_data= X_data.*Y_data; % Height^c*Weight
PP = polyfit(Z_data,Y_data,1); % linear fitting
Coefficient_a_Male_1_KNHANES_2013 = [Coefficient_a_Male_1_KNHANES_2013 PP(2)];
Coefficient_b_Male_1_KNHANES_2013 = [Coefficient_b_Male_1_KNHANES_2013 PP(1)];
