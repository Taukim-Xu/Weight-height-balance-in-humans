Coefficient_a_Female_1_KNHANES_ALL = [];
Coefficient_b_Female_1_KNHANES_ALL = [];
Coefficient_a_Male_1_KNHANES_ALL = [];
Coefficient_b_Male_1_KNHANES_ALL = [];

