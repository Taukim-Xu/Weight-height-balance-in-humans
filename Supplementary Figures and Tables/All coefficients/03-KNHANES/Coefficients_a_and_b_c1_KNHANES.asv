Y_data = Female_data_1(:,2); % Weight
Z_data= X_data.*Y_data; % Height^c*Weight
PP = polyfit(Z_data,Y_data,1); % linear fitting
Coefficient_a_Female_1_KNHANES_2008 = [Coefficient_a_Female_1_KNHANES_2008 PP(2)];
Coefficient_b_Female_1_KNHANES_2008 = [Coefficient_b_Female_1_KNHANES_2008 PP(1)];
